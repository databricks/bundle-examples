        "id": "44444444444444444444444444444444",
        "question": [
          "What was the total revenue per pickup zip code?"
        ],
        "sql": [
          "SELECT\n",
          "  pickup_zip,\n",
          "  SUM(fare_amount) AS total_revenue\n",
          "FROM samples.nyctaxi.trips\n",
          "GROUP BY pickup_zip\n",
          "ORDER BY total_revenue DESC"
        ]
      }
